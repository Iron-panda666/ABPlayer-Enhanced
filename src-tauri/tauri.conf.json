{
  "$schema": "https://raw.githubusercontent.com/nickkuk/nickkuk.github.io/master/tauri-v2-schema/tauri.conf.json",
  "productName": "ABPlayer-Enhanced",
  "mainBinaryName": "ABPlayer-Enhanced",
  "version": "1.8.0",
  "identifier": "com.ironpanda666.abplayer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ABPlayer-Enhanced",
        "width": 800,
        "height": 560,
        "minWidth": 540,
        "minHeight": 440,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost https://asset.localhost audiostream: http://audiostream.localhost https://audiostream.localhost; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; media-src * blob:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost asset: http://asset.localhost https://asset.localhost audiostream: http://audiostream.localhost https://audiostream.localhost https://openlibrary.org; object-src 'none'; base-uri 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/covers/**"
          ],
          "deny": []
        }
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "template": "installer/installer.nsi",
        "installerHooks": "installer/maintenance.nsh"
      }
    },
    "publisher": "ironpanda666",
    "homepage": "https://github.com/Iron-panda666/ABPlayer-Enhanced",
    "copyright": "Original ABPlayer: Jose Hidalgo (jhidalgo_dev / kurohige). Enhanced changes (c) 2026 Jiří Veselý, aka Iron-panda666.",
    "licenseFile": "../LICENSE.txt",
    "resources": {
      "../licenses/": "licenses/",
      "../UPSTREAM-PERMISSION.md": "UPSTREAM-PERMISSION.md",
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt",
      "../CHANGELOG.md": "CHANGELOG.md",
      "../LICENSE.txt": "LICENSE.txt",
      "../NOTICE.txt": "NOTICE.txt"
    }
  }
}
